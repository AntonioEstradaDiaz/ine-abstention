APP_NAME=INE Abstention API
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://ine:ine_local@localhost:5432/ine_abstention
POSTGRES_USER=ine
POSTGRES_PASSWORD=ine_local
POSTGRES_DB=ine_abstention
CORS_ORIGINS=[]
DATABASE_SCHEMA=public
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
# En Supabase: URL de migraciones con permisos DDL, separada del usuario de la API.
# MIGRATION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Producción: 32+ caracteres aleatorios, secretos y solo en servidores FastAPI/Next.js.
# ENVIRONMENT=production obliga a configurarlo y desactiva /docs.
# API_INTERNAL_TOKEN=
# Monitor por separado (mismo token), guardar en el gestor de secretos.
