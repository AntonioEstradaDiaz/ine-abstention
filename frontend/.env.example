# Solo se lee en el servidor de Next.js. No usar claves de Supabase en el navegador.
BACKEND_URL=http://127.0.0.1:8001
# Asistente IA de Predicciones (opcional). El modelo aún no está definido:
# se puede usar cualquier modelo instalado en Ollama; si OLLAMA_MODEL no existe, se usa el primero instalado.
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=

# Asistente remoto (predeterminado). Clave privada, nunca NEXT_PUBLIC_.
AI_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Para mantener el asistente local: AI_PROVIDER=ollama

# Proveedor recomendado para la demo online. Clave privada del servidor.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
