{
  "name": "ine-abstention-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prepare-maplibre.mjs",
    "predev": "node scripts/prepare-maplibre.mjs",
    "prebuild": "node scripts/prepare-maplibre.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "geo:download": "node scripts/fetch-geometry.mjs",
    "format": "prettier --write src tests scripts *.json *.ts *.mjs",
    "preview": "node scripts/preview.mjs",
    "test:ml": "node --experimental-strip-types --test tests/ml-scenario.test.mts",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mts"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "exceljs": "4.4.0",
    "lucide-react": "1.61.0",
    "maplibre-gl": "6.15.0",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
